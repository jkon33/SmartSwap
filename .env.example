# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secure secret used to sign Auth sessions
JWT_SECRET="smartswap_fallback_super_secret_jwt_key_2026"

# MONGODB_URI: Connection string to MongoDB Database Atlas or instance
MONGODB_URI=

# Optional SMTP Configuration for real Verification Emails
# For standard custom SMTP setups:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# For Gmail SMTP:
# Set SMTP_SERVICE="gmail", SMTP_USER to your Gmail address, and SMTP_PASS to a 16-character Google App Password (not your main log-in password)
# Learn more about Google App Passwords at: https://support.google.com/accounts/answer/185833
SMTP_SERVICE=


